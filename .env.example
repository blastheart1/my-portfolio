# Copy this file to .env.local and fill in your values.
# .env.example is safe to commit — it contains no real secrets.

# ── Neon Database ─────────────────────────────────────────────────────────────
# Neon Console → your project → Dashboard → Connection string → Pooled
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Console → Connection string → Direct (unpooled) — used for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Admin Auth ────────────────────────────────────────────────────────────────
# node -e "const b=require('bcryptjs'); b.hash('YOUR_PASSWORD',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=at-least-32-random-characters-here

# ── Vercel Blob ───────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ── Email via Resend ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
TO_EMAIL=you@example.com
NEXT_PUBLIC_FROM_EMAIL=noreply@yourdomain.com
NEXT_PUBLIC_TO_EMAIL=you@example.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Server-only. NEXT_PUBLIC_* values are inlined into the browser bundle, so a
# key read that way is published to every visitor. Guard rail N3 enforces this.
OPENAI_API_KEY=sk-proj-xxxxxxxx

# ── Anthropic (the publish gate's auditor) ────────────────────────────────────
# Normally read from the encrypted provider_credentials table; this is the
# fallback. scripts/publish-post.ts needs one or the other.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ── Cron auth ─────────────────────────────────────────────────────────────────
CRON_SECRET=any-random-string
