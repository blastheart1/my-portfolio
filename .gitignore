# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local documentation (setup guides, plans, notes — not committed)
/docs/

# sql dumps and one-off scratch queries
*.sql
# ...but NOT the migrations. This rule used to swallow them, which meant the
# entire schema history — including the files run-migration.mjs applies and
# records in schema_migrations — existed only on whichever laptop wrote them.
# A fresh clone had the runner and nothing to run.
!scripts/migrations/**/*.sql
!scripts/migrate-neon.sql

# Frame sequence source PNGs. The committed sequence is WebP (~8 MB vs 107 MB
# for the same frames as PNG). If you regenerate frames, convert before
# committing:  cwebp -q 80 in.png -o out.webp
public/frames/*.png

# ide / editor workspace files
.cursor/
*.code-workspace

# Local Claude Code settings and scratch plans — machine-specific
.claude/
